# SeatSync Global Configuration Example

# Backend Environment Variables (server/.env)
PORT=5000
NODE_ENV=production
JWT_SECRET=your-production-jwt-secret-replace-in-cloud
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# PostgreSQL Connection String (Supabase / Render / Neon / Local)
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seatsync?schema=public"

# Frontend Environment Variables (client/.env)
# For local development with proxy: /api
# For production deployed on Vercel:
VITE_API_BASE_URL="https://seatsync-api.onrender.com/api"

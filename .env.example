# ====================================================================
# SeatSync Complete Project Environment Configuration Template
# ====================================================================

# --------------------------------------------------------------------
# Backend Environment Variables (server/.env)
# --------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# JWT Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-secure-256-bit-random-secret
JWT_EXPIRES_IN=7d

# Production CORS Security (Set to your actual deployed frontend URL)
CORS_ORIGIN=https://seatsync.vercel.app
FRONTEND_URL=https://seatsync.vercel.app

# Supabase PostgreSQL Database URLs
# Obtain from: Supabase Dashboard -> Project Settings -> Database
# Transaction Pooler (Port 6543, recommended for cloud hosting):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct Connection (Port 5432, used for migrations):
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Production Administrator Provisioning
ADMIN_EMAIL=admin@seatsync.edu
ADMIN_INITIAL_PASSWORD=SetYourStrongAdminPassword2026!
SEED_DEMO_DATA=false

# --------------------------------------------------------------------
# Frontend Environment Variables (client/.env)
# --------------------------------------------------------------------
# In production on Vercel: Set to your public backend API URL
VITE_API_BASE_URL="https://seatsync-api.onrender.com/api"

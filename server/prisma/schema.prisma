datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

enum Role {
  STUDENT
  ADMIN
}

enum ReservationStatus {
  CONFIRMED
  CHECKED_IN
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BorrowStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LoanStatus {
  BORROWED
  RETURNED
  OVERDUE
}

enum SeatType {
  STANDARD
  POWER_OUTLET
  MONITOR_DESK
  SILENT_BOOTH
}

enum NotificationType {
  RESERVATION
  BORROWING
  SYSTEM
  ALERT
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  role         Role            @default(STUDENT)
  name         String
  studentId    String?         @unique
  department   String?
  phone        String?
  avatarUrl    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  studentProfile   StudentProfile?
  reservations     Reservation[]
  borrowRequests   BorrowRequest[]
  borrowingRecords BorrowingRecord[]
  notifications    Notification[]
}

model StudentProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  yearOfStudy       String?
  libraryCardNumber String   @unique
  maxBorrowLimit    Int      @default(3)
  status            String   @default("ACTIVE")
  fineAmount        Float    @default(0.0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Seat {
  id          String        @id @default(uuid())
  seatNumber  String        @unique
  floor       Int           @default(1)
  section     String
  type        SeatType      @default(STANDARD)
  hasPower    Boolean       @default(true)
  hasMonitor  Boolean       @default(false)
  isActive    Boolean       @default(true)
  row         String
  column      Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  reservations Reservation[]

  @@index([floor, section])
}

model Reservation {
  id              String            @id @default(uuid())
  reservationCode String            @unique
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  seatId          String
  seat            Seat              @relation(fields: [seatId], references: [id], onDelete: Cascade)
  date            String
  startTime       String
  endTime         String
  status          ReservationStatus @default(CONFIRMED)
  qrCodeData      String            @db.Text
  checkInTime     DateTime?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  checkIns CheckIn[]

  @@index([seatId, date, startTime, endTime])
  @@index([seatId, date, status])
  @@index([userId, date])
}

model CheckIn {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  checkInMethod String      @default("QR_SCAN")
  checkInTime   DateTime    @default(now())
  deviceDetails String?
  createdAt     DateTime    @default(now())
}

model BookCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books Book[]
}

model Book {
  id               String       @id @default(uuid())
  title            String
  author           String
  isbn             String       @unique
  categoryId       String
  category         BookCategory @relation(fields: [categoryId], references: [id])
  description      String       @db.Text
  publisher        String
  publicationYear  Int
  coverImage       String       @db.Text
  totalCopies      Int          @default(1)
  availableCopies  Int          @default(1)
  locationShelf    String
  rating           Float        @default(4.5)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  borrowRequests   BorrowRequest[]
  borrowingRecords BorrowingRecord[]

  @@index([title])
  @@index([author])
  @@index([isbn])
  @@index([categoryId])
}

model BorrowRequest {
  id              String       @id @default(uuid())
  requestCode     String       @unique
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId          String
  book            Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  requestDate     DateTime     @default(now())
  status          BorrowStatus @default(PENDING)
  reviewDate      DateTime?
  reviewedByUserId String?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  borrowingRecord BorrowingRecord?

  @@index([userId, status])
  @@index([bookId, status])
}

model BorrowingRecord {
  id          String         @id @default(uuid())
  borrowCode  String         @unique
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId      String
  book        Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  requestId   String?        @unique
  request     BorrowRequest? @relation(fields: [requestId], references: [id])
  borrowDate  DateTime       @default(now())
  dueDate     DateTime
  returnDate  DateTime?
  status      LoanStatus     @default(BORROWED)
  fineAmount  Float          @default(0.0)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, status])
  @@index([bookId, status])
  @@index([dueDate])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  linkUrl   String?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

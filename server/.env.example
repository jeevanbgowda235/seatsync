# ====================================================================
# SeatSync Server Environment Configuration (Production & Supabase)
# ====================================================================

# Port and Environment
PORT=5000
NODE_ENV=production

# --------------------------------------------------------------------
# 1. JWT Authentication Secret
# --------------------------------------------------------------------
# Generate a cryptographically secure 256-bit key using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit your production secret to version control.
JWT_SECRET=replace-with-a-secure-256-bit-random-secret
JWT_EXPIRES_IN=7d

# --------------------------------------------------------------------
# 2. CORS Allowed Origins (Production Security)
# --------------------------------------------------------------------
# Specify your deployed frontend domain(s). Multiple domains can be comma-separated.
# Example: https://seatsync-vjgetntqa-zap-i.vercel.app,https://seatsync.vercel.app
CORS_ORIGIN=https://seatsync-vjgetntqa-zap-i.vercel.app,https://seatsync.vercel.app
CLIENT_URL=https://seatsync-vjgetntqa-zap-i.vercel.app
FRONTEND_URL=https://seatsync-vjgetntqa-zap-i.vercel.app

# --------------------------------------------------------------------
# 3. Supabase PostgreSQL Connection Strings
# --------------------------------------------------------------------
# Obtain these from: Supabase Dashboard -> Project Settings -> Database -> Connection string
#
# Option A (Recommended for Serverless / Render / Container): Transaction Pooler (Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Option B: Direct Database Connection (Port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --------------------------------------------------------------------
# 4. Initial Administrative Account (Optional for Production Setup)
# --------------------------------------------------------------------
ADMIN_EMAIL=admin@seatsync.edu
ADMIN_INITIAL_PASSWORD=SetYourStrongAdminPassword2026!

# Set to false in production to prevent seeding demo student accounts
SEED_DEMO_DATA=false

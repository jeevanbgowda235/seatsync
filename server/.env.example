# SeatSync Server Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=your-production-jwt-secret-replace-in-cloud
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# PostgreSQL Connection String
# For Supabase / Render / Neon PostgreSQL:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seatsync?schema=public"
